# Vorlage für die lokale Entwicklung – echte Werte gehören in .env (nicht ins Repo).
# Die Werte für die lokale Umgebung zeigt `supabase start` an.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key aus "supabase start">
VITE_SUPABASE_PROJECT_ID=local

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<anon-key aus "supabase start">
SUPABASE_SERVICE_ROLE_KEY=<service-role-key aus "supabase start">

# Optional: Zahlungsanbieter und KI im lokalen Test
STRIPE_SECRET_KEY=
LOVABLE_API_KEY=
